STEP 11 
Metadata Validation
Before running any Snowflake query, we need to verify two things: 
Excel Structure is Correct and Excel Data is Correct
If not then Framework should stop Execution.
•	Start with creating a new file name “metadata_validator.py” in engine folder as:
engine/ metadata_validator.py
•	Create a simple function to check if it is working when called from “main.py”. The function is as:
def validate_metadata(df):
    print("Metadata Validation Started")
    return True
•	Call It From “main.py” as:
Add import:
from engine.metadata_validator import validate_metadata
After reading Excel files (df = read_excel_file(excel_path) ), add this:
validation_status = validate_metadata(df)
print(validation_status)
•	Run in the terminal “python main.py”. We will get output as: “Metadata Validation Started”, which means that “metadata_validator.py” is connected properly.
•	Final script for metadata_validator.py will be: 


def validate_metadata(df):
    """
    Validate Excel metadata before executing any Snowflake queries.
    """

    print("\nStarting Metadata Validation...\n")

    # =====================================================
    # 1. Required Columns Validation
    # =====================================================

    required_columns = [
        "test_case_id",
        "source_table",
        "target_table",
        "validation_type",
        "validation_column",
        "business_key"
    ]

    missing_columns = []

    for column in required_columns:
        if column not in df.columns:
            missing_columns.append(column)

    if missing_columns:
        raise Exception(
            f"Missing Required Columns: {', '.join(missing_columns)}"
        )

    print("✓ Required Columns Validation Passed")

    # =====================================================
    # 2. Supported Validation Types
    # =====================================================

    allowed_validations = [
        "row_count",
        "null_check",
        "duplicate_check",
        "source_target_compare",
        "aggregate_check",
        "date_check"
    ]

    # =====================================================
    # 3. Row Level Validation
    # =====================================================

    for index, row in df.iterrows():

        test_case_id = str(row["test_case_id"]).strip()
        source_table = str(row["source_table"]).strip()
        target_table = str(row["target_table"]).strip()
        validation_type = str(row["validation_type"]).strip()

        validation_column = str(
            row["validation_column"]
        ).strip()

        business_key = str(
            row["business_key"]
        ).strip()

        # ---------------------------------------------
        # Mandatory Fields Validation
        # ---------------------------------------------

        if not test_case_id:
            raise Exception(
                f"Row {index+2}: test_case_id is blank"
            )

        if not source_table:
            raise Exception(
                f"{test_case_id}: source_table is blank"
            )

        if not target_table:
            raise Exception(
                f"{test_case_id}: target_table is blank"
            )

        if not validation_type:
            raise Exception(
                f"{test_case_id}: validation_type is blank"
            )

        # ---------------------------------------------
        # Validation Type Check
        # ---------------------------------------------

        if validation_type not in allowed_validations:
            raise Exception(
                f"{test_case_id}: Invalid validation_type "
                f"'{validation_type}'"
            )

        # ---------------------------------------------
        # business_key Validation
        # ---------------------------------------------

        if validation_type in [
            "duplicate_check",
            "source_target_compare"
        ]:

            if (
                business_key == ""
                or
                business_key.lower() == "nan"
            ):
                raise Exception(
                    f"{test_case_id}: "
                    f"business_key is mandatory for "
                    f"{validation_type}"
                )

        # ---------------------------------------------
        # validation_column Validation
        # ---------------------------------------------

        if validation_type in [
            "null_check",
            "aggregate_check",
            "date_check"
        ]:

            if (
                validation_column == ""
                or
                validation_column.lower() == "nan"
            ):
                raise Exception(
                    f"{test_case_id}: "
                    f"validation_column is mandatory for "
                    f"{validation_type}"
                )

    print("✓ Validation Type Checks Passed")
    print("✓ business_key Validation Passed")
    print("✓ validation_column Validation Passed")

    # =====================================================
    # 4. Duplicate Test Case Validation
    # =====================================================

    duplicate_rows = df[
        df.duplicated(
            subset=[
                "test_case_id"
            ],
            keep=False
        )
    ]

    if len(duplicate_rows) > 0:

        duplicate_test_cases = (
            duplicate_rows["test_case_id"]
            .unique()
            .tolist()
        )

        raise Exception(
            "Duplicate test_case_id found: "
            + ", ".join(
                map(str, duplicate_test_cases)
            )
        )

    print("✓ Duplicate Test Case Validation Passed")

    print("\nMetadata Validation Successful\n")

    return True

